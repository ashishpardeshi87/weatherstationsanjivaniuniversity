# Copy this file to .env and fill in real values.
# Credentials for the upstream VIYAT WeatherCast account.
WC_USERNAME=sanjivani_university
WC_PASSWORD=sanjivani_u@321

# Station to display. Leave blank to auto-pick the first machine on the account.
WC_MACHINE_ID=

# Local server port
PORT=4000

# How often (ms) the backend pulls a fresh reading from the upstream station.
REFRESH_MS=15000
